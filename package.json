{
  "name": "toanlvk",
  "version": "1.0.0",
  "description": "Cờ Đông Sơn: hai người cùng thiết bị, Python/Pyodide trong Web Worker, website tĩnh",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "node scripts/build-pages.cjs",
    "package:source": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-source.ps1",
    "test:pages": "playwright test --config playwright.pages.config.cjs",
    "preview": "vite preview",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "playwright test",
    "dev:api": "node scripts/run-python.cjs -m uvicorn server:app --app-dir src --host 127.0.0.1 --port 8000 --workers 1",
    "test:api": "node scripts/run-python.cjs -m pytest src -q -p no:cacheprovider",
    "test:browser:install": "node scripts/install-browser.cjs",
    "build:exe": "node scripts/build-desktop.cjs",
    "start": "node scripts/serve-static.cjs",
    "start:api": "node scripts/run-python.cjs -m uvicorn web:app --app-dir src --host 0.0.0.0 --port 8000 --workers 1",
    "test:web": "node scripts/run-python.cjs -m pytest tests/test_web_host.py -q -p no:cacheprovider",
    "pretest:web:browser": "node scripts/run-python.cjs scripts/make-worker-fixtures.py",
    "test:web:browser": "playwright test --config playwright.local.config.cjs",
    "test:bridge": "node scripts/run-python.cjs -m pytest tests/test_browser_bridge.py -q -p no:cacheprovider",
    "test:bot": "node scripts/run-python.cjs -m pytest tests/test_bot_agent.py tests/test_bot_policies.py -q -p no:cacheprovider",
    "test:files": "node scripts/run-python.cjs -m pytest tests/test_game_files.py -q -p no:cacheprovider",
    "test:desktop": "node scripts/run-python.cjs -m pytest tests/test_desktop_host.py -q -p no:cacheprovider"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "pixi.js": "8.14.0",
    "pyodide": "0.29.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "vite": "6.4.5"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.16.0"
}
